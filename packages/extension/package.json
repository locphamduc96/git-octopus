{
  "name": "git-octopus",
  "displayName": "Git Octopus",
  "description": "View a Git graph of your repository and perform Git actions from it.",
  "version": "0.0.1",
  "publisher": "locpham",
  "license": "MIT",
  "type": "commonjs",
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": ["SCM Providers", "Other"],
  "main": "./dist/extension.js",
  "repository": {
    "type": "git",
    "url": "https://github.com/locphamduc96/git-octopus.git"
  },
  "contributes": {
    "viewsContainers": {
      "panel": [
        {
          "id": "git-octopus-panel",
          "title": "Git Octopus",
          "icon": "$(git-branch)"
        }
      ]
    },
    "views": {
      "git-octopus-panel": [
        {
          "type": "webview",
          "id": "git-octopus.view",
          "name": "Git Octopus"
        }
      ]
    },
    "commands": [
      {
        "category": "Git Octopus",
        "command": "git-octopus.refresh",
        "title": "Refresh"
      },
      {
        "category": "Git Octopus",
        "command": "git-octopus.focus",
        "title": "Open Git Octopus"
      },
      {
        "category": "Git Octopus",
        "command": "git-octopus.openInTab",
        "title": "Open Git Octopus in Editor Tab"
      }
    ]
  },
  "scripts": {
    "build": "node esbuild.mjs",
    "dev": "node esbuild.mjs --watch",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "package": "node esbuild.mjs && vsce package --no-dependencies -o ../../git-octopus.vsix"
  },
  "dependencies": {
    "@git-octopus/graph-layout": "workspace:*",
    "@git-octopus/shared": "workspace:*"
  },
  "devDependencies": {
    "@types/vscode": "^1.90.0",
    "@vscode/vsce": "^2.15.0",
    "esbuild": "^0.24.2"
  }
}
